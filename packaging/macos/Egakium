#!/bin/zsh

set -euo pipefail

egakium_launcher=${0:A}
egakium_contents=${egakium_launcher:h:h}
egakium_bundle=${egakium_contents:h}
egakium_project_root=${egakium_bundle:h:h}

egakium_default_chromium="$egakium_project_root/Chromium/checkout/src/out/EgakiumNative/Chromium.app/Contents/MacOS/Chromium"
egakium_chromium=${EGAKIUM_CHROMIUM_EXECUTABLE:-$egakium_default_chromium}

egakium_source_canvas="$egakium_project_root/src/canvas/index.html"
egakium_packaged_canvas="$egakium_contents/Resources/canvas/index.html"

if [[ -f "$egakium_source_canvas" ]]; then
  egakium_canvas=$egakium_source_canvas
else
  egakium_canvas=$egakium_packaged_canvas
fi

if [[ ! -x "$egakium_chromium" ]]; then
  print -u2 -- "Egakium: Chromium executable not found: $egakium_chromium"
  exit 1
fi

if [[ ! -f "$egakium_canvas" ]]; then
  print -u2 -- "Egakium: canvas document not found: $egakium_canvas"
  exit 1
fi

egakium_default_profile="$egakium_project_root/.runtime/chromium-profile"
egakium_profile=${EGAKIUM_USER_DATA_DIR:-$egakium_default_profile}
/bin/mkdir -p "$egakium_profile"

egakium_canvas_url="file://$egakium_canvas"

exec "$egakium_chromium" \
  --user-data-dir="$egakium_profile" \
  --no-first-run \
  --no-default-browser-check \
  --app="$egakium_canvas_url" \
  "$@"
